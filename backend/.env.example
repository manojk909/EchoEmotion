# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="EchoEmotion"
APP_VERSION="2.0.0"
DEBUG=false
SECRET_KEY="change-me-to-a-random-32-char-string"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://ser_user:ser_pass@localhost:5432/ser_db"
DATABASE_URL_SYNC="postgresql://ser_user:ser_pass@localhost:5432/ser_db"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── ML ────────────────────────────────────────────────────────────────────────
# Place RAVDESS Actor_* folders inside this path
DATASET_PATH="./dataset"
MODELS_DIR="./models"
UPLOAD_FOLDER="./uploads"
MAX_UPLOAD_SIZE_MB=16
N_MFCC=40
